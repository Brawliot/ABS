    {
      "id": "p02.d1",
      "question": "¿Financiera propia y externa son la misma secundaria o dos bindings?",
      "chosen": "misma_secundaria_con_parte_distinta",
      "alternatives": [
        {
          "option": "misma_secundaria_con_parte_distinta",
          "pros": "un solo bloquea",
          "cons": "hay que tipar Parte garante/tercero"
        },
        {
          "option": "dos_secundarias_financiera",
          "pros": "aisla riesgo externo",
          "cons": "posible multi-bloquea al mismo estado (válido pero más UI)"
        }
      ],
      "resolution": "ACCEPTED"
    },
    {
      "id": "p02.d2",
      "question": "¿bloquea en_ejecucion o cerrada?",
      "chosen": "en_ejecucion",
      "alternatives": [
        {
          "option": "en_ejecucion",
          "pros": "cumple 'no iniciar sin señal'",
          "cons": "más estricto"
        },
        {
          "option": "cerrada",
          "pros": "como heurístico actual",
          "cons": "permite iniciar tratamiento sin señal"
        }
      ],
      "resolution": "ACCEPTED"
    },
    {
      "id": "p02.d3",
      "question": "¿Sesiones = un servicio_proyecto o N txs vinculadas?",
